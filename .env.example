# Telegram API Credentials
# Get these from https://my.telegram.org/apps
API_ID=12345
API_HASH=your_api_hash_here

# Session String
# You can generate this by running a separate script or use phone number login
# Leave empty to use phone number login
SESSION_STRING=

# Optional assistant bot token from @BotFather. Leave empty to disable bot handlers.
BOT_TOKEN=

# Optional: Command Prefix (default is .)
CMD_PREFIX=.

# Optional: Todoist Integration (.todo command)
#
# How to get your API token:
#   1. Sign in to Todoist (https://app.todoist.com).
#   2. Open Settings -> Integrations -> Developer.
#      (Direct link: https://app.todoist.com/app/settings/integrations/developer)
#   3. Copy the "API token" shown there.
#   4. Paste it below (no quotes/spaces) and restart the bot.
#
# On first use the bot auto-creates a section and a label named
# "📩 From Telegram [UserBot]" in your Todoist inbox.
TODOIST_API_TOKEN=your_todoist_api_token_here

# Optional: Web search / page reader (.web, .open, .read commands)
# Any You.com-compatible JSON search endpoint works - swap the URL/key/header
# to change providers without touching code. The endpoint receives:
#   POST {"query": "...", "count": N, "offset": N}
# and should return results at results.web (or results/news, as a list).
BROWSER_API_URL=https://ydc-index.io/v1/search
BROWSER_API_KEY=
BROWSER_API_KEY_HEADER=X-API-Key

# Optional: AI chat (.ai command)
# Numbered OpenAI-compatible /chat/completions providers are tried in order.
# OpenRouter first (use your OpenRouter key and the exact model id from its catalog).
AI_API_URL_1=https://openrouter.ai/api/v1
AI_API_KEY_1=your_openrouter_api_key
AI_MODEL_1=deepseek/deepseek-chat-v3.1
# Groq is used as fallback if provider 1 fails.
AI_API_URL_2=https://api.groq.com/openai/v1
AI_API_KEY_2=your_groq_api_key
AI_MODEL_2=openai/gpt-oss-120b
AI_SYSTEM_PROMPT=You are a helpful, concise assistant.

# Optional: Spam limits
MAX_SPAM_COUNT=100
SPAM_DELAY=0.5

# Client Customization
CLIENT_NAME=NekoUB
APP_VERSION=NekoUB 1.0.0
WORKERS=8
PARSE_MODE=markdown


# Sticker set name format
#
# Placeholders: {user_id}, {first_name}, {username}, {base}, {suffix}, {index}
#
# STICKERSET_NAME_FORMAT -> exact short_name template (used in deep links / API).
#   The formatted value is used as-is; no volume or user-id suffix is appended.
#   Telegram requires short names to be globally unique.
# STICKERSET_TITLE_FORMAT -> display title shown in Telegram
#   default: "@<username> <suffix>" (e.g. "@OpPeace fun")
#
# Leave empty (or "") to use the defaults.
#
# STICKERSET_BASE -> optional override for the base name (defaults to
#   "@<username>", falls back to first name). Set e.g. STICKERSET_BASE=OpPeace
STICKERSET_NAME_FORMAT=""
STICKERSET_TITLE_FORMAT=""
# Optional templates used only for themed packs selected with `.kang -t <theme>`.
# Empty uses the normal {base}_{suffix} / "{base} {suffix}" themed naming.
THEMED_STICKERSET_SHORTNAME=""
THEMED_STICKERSET_DISPLAY_NAME=""
STICKERSET_BASE=""
# Sticker media conversion (.kang on images / GIFs / videos)
#
# Images become 512x512 WEBP static stickers; GIFs and videos become
# 512x512 VP9 WEBM video stickers (max 3s, 30fps, no audio).
#
# FFMPEG_BINARY -> path to the ffmpeg executable. Leave empty to
#   auto-detect (PATH, then ~/.local/bin/ffmpeg).
FFMPEG_BINARY=""

# SangMata name-history lookup (.sg)
#
# The userbot talks to this bot to fetch past names/usernames.
# SANGMATA_BOT -> SangMata bot username (default: SangMata_BOT).
# The userbot sends the target's numeric id as a plain message.
SANGMATA_BOT="SangMata_BOT"

# Translate (.tr)
# TRANSLATE_API_URL -> Google gtx translate endpoint (no key needed).
# TRANSLATE_TARGET  -> default target language code (e.g. en, hi, es).
TRANSLATE_API_URL="https://translate.googleapis.com/translate_a/single"
TRANSLATE_TARGET="en"

# Text to speech (.tts) - Microsoft Edge neural voices.
# TTS_VOICE -> run `edge-tts --list-voices` for options.
TTS_VOICE="en-US-AriaNeural"

# Voice-note transcription for .tr (Groq Whisper)
# GROQ_API_KEY  -> a Groq API key (https://console.groq.com/keys).
# GROQ_API_KEYS -> comma-separated fallback list (optional).
# If both are empty, enabled Groq keys are read from the local synckey
# store (~/.synckey/synckey.db) automatically.
# TRANSCRIBE_MODEL -> whisper-large-v3 (multilingual) or
#   whisper-large-v3-turbo (faster/cheaper).
GROQ_API_KEY=""
GROQ_API_KEYS=""
TRANSCRIBE_MODEL="whisper-large-v3"

# Debug: forward the bot's logs to a Telegram chat.
# DEBUG_CHAT_ID   -> target chat/group id (negative for groups). Empty = off.
# Required for temporary .kang sticker uploads; uploads are deleted after use.
# DEBUG_LOG_LEVEL -> minimum level to forward. Use ERROR to get only
#                    failures (recommended), or DEBUG/INFO/WARNING for more.
# A "🟢 NekoUB online" notice is always sent on startup/restart, regardless
# of the level.
DEBUG_CHAT_ID=""
DEBUG_LOG_LEVEL="ERROR"
