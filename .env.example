# Telegram API Credentials
# Get these from https://my.telegram.org/apps
API_ID=12345
API_HASH=your_api_hash_here

# Session String
# You can generate this by running a separate script or use phone number login
# Leave empty to use phone number login
SESSION_STRING=

# Optional: Command Prefix (default is .)
CMD_PREFIX=.

# Optional: Todoist Integration (.todo command)
TODOIST_API_TOKEN=

# Optional: Web search / page reader (.web, .open, .read commands)
# Any You.com-compatible JSON search endpoint works - swap the URL/key/header
# to change providers without touching code. The endpoint receives:
#   POST {"query": "...", "count": N, "offset": N}
# and should return results at results.web (or results/news, as a list).
BROWSER_API_URL=https://ydc-index.io/v1/search
BROWSER_API_KEY=
BROWSER_API_KEY_HEADER=X-API-Key

# Optional: AI chat (.ai command)
# Any OpenAI-compatible /chat/completions endpoint works (e.g. a synckey
# gateway). AI_MODEL must be the exact id the endpoint expects.
AI_API_URL=http://127.0.0.1:8787/v1
AI_API_KEY=
AI_MODEL=groq/openai/gpt-oss-120b
AI_SYSTEM_PROMPT=You are a helpful, concise assistant.

# Optional: Spam limits
MAX_SPAM_COUNT=100
SPAM_DELAY=0.5

# Client Customization
CLIENT_NAME=NekoUB
APP_VERSION=NekoUB 1.0.0
WORKERS=8
PARSE_MODE=markdown


# Sticker set name format
#
# Placeholders: {user_id}, {first_name}, {username}, {base}, {suffix}, {index}
#
# STICKERSET_NAME_FORMAT  -> short_name (used in deep links / API)
#   default: "<username>_<suffix>_<user_id>" (or "_vol{index}" for the
#            default pack). Telegram requires short names to be globally
#            unique, so the user id is appended.
# STICKERSET_TITLE_FORMAT -> display title shown in Telegram
#   default: "@<username> <suffix>" (e.g. "@OpPeace fun")
#
# Leave empty (or "") to use the defaults.
#
# STICKERSET_BASE -> optional override for the base name (defaults to
#   "@<username>", falls back to first name). Set e.g. STICKERSET_BASE=OpPeace
STICKERSET_NAME_FORMAT=""
STICKERSET_TITLE_FORMAT=""
STICKERSET_BASE=""

# Sticker media conversion (.kang on images / GIFs / videos)
#
# Images become 512x512 WEBP static stickers; GIFs and videos become
# 512x512 VP9 WEBM video stickers (max 3s, 30fps, no audio).
#
# FFMPEG_BINARY -> path to the ffmpeg executable. Leave empty to
#   auto-detect (PATH, then ~/.local/bin/ffmpeg).
FFMPEG_BINARY=""
